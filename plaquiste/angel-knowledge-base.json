    "language": "fr-FR",
    "purpose": "Fournir à Ángel une base métier structurée pour répondre aux questions sur le chiffrage plaquiste sans inventer de règles, de prix ni d'unités.",
    "source_of_truth": [
      "plaquiste/engine-real.js — règles métier et abaque isolation",
      "plaquiste/app.js — validations, catalogue démo, calculs et flux UI",
      "Les données réelles SpeedArti (catalogue utilisateur/fournisseur, stock, Supabase) priment dès qu'elles sont raccordées."
    ]
  },
  "speedarti_guardrails": {
    "never_invent": true,
    "source_of_truth_is_real_code": true,
    "explicit_units_required": true,
    "trace_sensitive_calculations": true,
    "user_input_must_have_effect": true,
    "preserve_existing_workflow": true,
    "human_validation_for_ai_or_imported_uncertain_data": true,
    "manufacturer_or_real_catalog_priority": true,
    "price_policy": [
      "Ne jamais demander à l'artisan un prix déjà présent dans le catalogue SpeedArti.",
      "Un prix de démonstration ou public doit être identifié comme tel.",
      "Un prix fournisseur réel raccordé remplace toujours un prix de démonstration."
    ],
    "isolation_policy": [
      "L'artisan choisit son produit d'isolation.",
      "Ne pas demander une validation artisan supplémentaire après son choix explicite.",
      "Respecter référence, épaisseur, prix HT/m², simple/double couche et pose croisée."
