  "validation_rules": [
    "Un ouvrage doit être actif pour être calculé.",
    "Une cloison possède deux faces ; un doublage une seule face.",
    "Longueur et hauteur doivent être positives.",
    "Le type de plaque et simple/double peau doivent être choisis explicitement.",
    "Au-delà du format automatique disponible, le nombre réel de plaques doit être saisi explicitement.",
    "Les ouvertures sont déduites des surfaces et génèrent l'ossature périphérique prévue.",
    "Un plafond actif doit avoir un type, une surface valide, un parement, un format de plaque, une longueur de suspente et simple/double peau.",
    "La complexité générale, le taux horaire, la marge matériaux, l'âge du logement et le niveau de finition sont des paramètres explicites.",
    "Les prix catalogue intégrés ne doivent pas être redemandés à l'artisan.",
    "Les coûts internes de finition ne doivent pas être refacturés une deuxième fois."
  ],
  "output_expectations": [
    "Surfaces par ouvrage, y compris plafonds.",
    "Matériaux et commandes avec quantités, unités, conditionnements, PU HT et total HT.",
    "Total matériaux HT.",
    "Coûts internes de finition séparés du total facturé.",
    "Main-d'œuvre en heures et coût.",
    "Vente/forfaits, TVA et total TTC.",
    "Alertes et blocages traçables avec code explicite."
  ],
  "angel_query_contract": {
    "supported_intents": [
      "expliquer une règle métier",
      "expliquer pourquoi un chiffrage est bloqué",
      "expliquer une quantité ou une unité",
      "identifier les données manquantes",
      "expliquer le choix d'un conditionnement",
      "expliquer une règle d'isolation, de plafond, de cloison ou de doublage"
    ],
    "answer_requirements": [
      "Répondre à partir de cette base et du contexte du chiffrage.",
      "Citer le nom de la règle ou le champ concerné quand c'est possible.",
      "Ne jamais inventer une référence produit, un prix fournisseur, une norme ou une performance non présente dans les sources.",
      "Si la réponse dépend d'un catalogue réel non raccordé, le dire clairement."
    ]
  },
